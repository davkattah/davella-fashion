{
  "openapi": "3.0.0",
  "info": {
    "title": "DAVella's Fashion Haute Couture & Fashion API",
    "version": "1.0.0",
    "description": "Full REST API specification for DAVella's Fashion luxury fashion e-commerce, wholesale B2B, order management, and CMS."
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check status",
        "responses": {
          "200": { "description": "Server is online and healthy" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "User authentication",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Returns JWT token and user profile" }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "List and filter products",
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "gender", "in": "query", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "List of products" }
        }
      },
      "post": {
        "summary": "Create product (Admin only)",
        "responses": {
          "201": { "description": "Product created" }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "Submit new customer order",
        "responses": {
          "201": { "description": "Order confirmed with tracking number" }
        }
      }
    }
  }
}
